{
  "name": "anime-vault-backend",
  "version": "2.0.0",
  "description": "API REST AnimeVault — Express + MySQL/MariaDB",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:migrate": "node db/migrate.js",
    "db:import-json": "node db/import-json.js",
    "test": "cross-env NODE_ENV=test DB_NAME=animevault_test node --test --test-concurrency=1 \"tests/*.test.js\""
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "multer": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.3.1"
  }
}
